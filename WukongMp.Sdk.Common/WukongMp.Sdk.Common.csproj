<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    </PropertyGroup>

    <!-- The core SDK. Defaults to the submodule here; an uberrepo overrides it
     so one checkout is shared across every consumer. -->
    <PropertyGroup>
        <CoreSdkRoot Condition="'$(CoreSdkRoot)' == ''">$(MSBuildThisFileDirectory)..\readym-core-sdk</CoreSdkRoot>
    </PropertyGroup>
    
    <ItemGroup>
        <ProjectReference Include="$(CoreSdkRoot)\src\ReadyM.SDK\ReadyM.SDK.csproj"/>
        <ProjectReference Include="$(CoreSdkRoot)\src\ReadyM.Api.Generators\ReadyM.Api.Generators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer"/>
        <ProjectReference Include="..\ReadyM.Wukong.Common\ReadyM.Wukong.Common.csproj"/>
    </ItemGroup>

</Project>
