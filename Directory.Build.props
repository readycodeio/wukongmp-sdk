<?xml version="1.0" encoding="utf-8"?>

<Project>
    <PropertyGroup>
        <FileVersion>0.3.1</FileVersion>
        <Version>0.3.1</Version>
        <InformationalVersion>0.3.1</InformationalVersion>
    </PropertyGroup>
    <PropertyGroup Condition="'$(UseBuildTimestamp)' == 'true'">
        <!-- Number of days since Dec 17, 2024 -->
        <BuildValue>$([System.DateTime]::op_Subtraction($([System.DateTime]::UtcNow), $([System.DateTime]::Parse('2024-12-17'))).Days)</BuildValue>
        <!-- Hours and minutes as a four-digit number -->
        <RevisionValue>$([System.DateTime]::UtcNow.ToString('HHmm'))</RevisionValue>
        <!-- Date and time concatenated into one always-increasing build number, e.g. 6041416.
             HHmm is zero padded, so the concatenation keeps increasing across midnight. -->
        <BuildTimestamp>$(BuildValue)$(RevisionValue)</BuildTimestamp>
        <InformationalVersion>0.3.1.$(BuildTimestamp)</InformationalVersion>
    </PropertyGroup>
    <PropertyGroup>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <UseSdkProjectReferences>true</UseSdkProjectReferences>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'NoDisconnect'">
        <DefineConstants>$(DefineConstants);DEBUG;NO_DISCONNECT</DefineConstants>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <OutputPath>bin\NoDisconnect\</OutputPath>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>portable</DebugType>
        <IntermediateOutputPath>obj\NoDisconnect\</IntermediateOutputPath>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Testing'">
        <DefineConstants>$(DefineConstants);DEBUG;TESTING</DefineConstants>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <OutputPath>bin\Testing\</OutputPath>
        <DebugSymbols>true</DebugSymbols>
        <IntermediateOutputPath>obj\Testing\</IntermediateOutputPath>
    </PropertyGroup>
    <PropertyGroup>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>
    <PropertyGroup>
        <CodeAnalysisRuleSet>$(MSBuildThisFileDirectory)/RuleSet.ruleset</CodeAnalysisRuleSet>
    </PropertyGroup>
</Project>
