<?xml version="1.0" encoding="utf-8"?>

<Project>
    <!--
        MSBuild stops at the first Directory.Build.props it finds walking up, so without
        this import an uberrepo above us could not contribute anything. Importing it first
        means outer values are already set when conditional defaults elsewhere run, so the
        outer ones win and a standalone clone is unaffected.

        The path goes through a property because a Condition cannot contain the nested
        quotes that GetPathOfFileAbove's arguments need.
    -->
    <PropertyGroup>
        <ParentBuildProps>$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))</ParentBuildProps>
    </PropertyGroup>
    <Import Project="$(ParentBuildProps)" Condition="'$(ParentBuildProps)' != ''" />

    <PropertyGroup>
        <FileVersion>0.3.1</FileVersion>
        <Version>0.3.1</Version>
        <InformationalVersion>0.3.1</InformationalVersion>
    </PropertyGroup>
    <PropertyGroup Condition="'$(UseBuildTimestamp)' == 'true'">
        <!-- Number of days since Dec 17, 2024 -->
        <BuildValue>$([System.DateTime]::op_Subtraction($([System.DateTime]::UtcNow), $([System.DateTime]::Parse('2024-12-17'))).Days)</BuildValue>
        <!-- Hours and minutes as a four-digit number -->
        <RevisionValue>$([System.DateTime]::UtcNow.ToString('HHmm'))</RevisionValue>
        <!-- Date and time concatenated into one always-increasing build number, e.g. 6041416.
             HHmm is zero padded, so the concatenation keeps increasing across midnight. -->
        <BuildTimestamp>$(BuildValue)$(RevisionValue)</BuildTimestamp>
        <InformationalVersion>0.3.1.$(BuildTimestamp)</InformationalVersion>
    </PropertyGroup>
    <PropertyGroup>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <UseSdkProjectReferences>true</UseSdkProjectReferences>
        <!-- The SDK ships as one package, ReadyM.SDK.Wukong, built by the project under
             Packaging/. Individual projects are not published, so keep them unpackable
             and let that project opt itself back in. -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'NoDisconnect'">
        <DefineConstants>$(DefineConstants);DEBUG;NO_DISCONNECT</DefineConstants>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <OutputPath>bin\NoDisconnect\</OutputPath>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>portable</DebugType>
        <IntermediateOutputPath>obj\NoDisconnect\</IntermediateOutputPath>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Testing'">
        <DefineConstants>$(DefineConstants);DEBUG;TESTING</DefineConstants>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <OutputPath>bin\Testing\</OutputPath>
        <DebugSymbols>true</DebugSymbols>
        <IntermediateOutputPath>obj\Testing\</IntermediateOutputPath>
    </PropertyGroup>
    <PropertyGroup>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>
    <PropertyGroup>
        <CodeAnalysisRuleSet>$(MSBuildThisFileDirectory)/RuleSet.ruleset</CodeAnalysisRuleSet>
    </PropertyGroup>
</Project>
