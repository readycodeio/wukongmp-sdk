<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <LangVersion>14</LangVersion>
        <OutputType>Library</OutputType>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <DebugType>portable</DebugType>
        <PackageId>WukongMp.Api</PackageId>
        <RootNamespace>WukongMp.Api</RootNamespace>
        <Nullable>enable</Nullable>
        <WarningsAsErrors>CS8600;CS8602;CS8603;CS8604;CS8618;CS8625;CS8619</WarningsAsErrors>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Configurations>Debug;Release;NoDisconnect;Testing</Configurations>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <Platforms>AnyCPU</Platforms>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <TargetFramework>netstandard2.0</TargetFramework>
    </PropertyGroup>
    
    <ItemGroup>
        <Reference Include="CSharpModBaseV2">
          <HintPath>Core\CSharpModBaseV2.dll</HintPath>
        </Reference>
        <Reference Include="Harmony">
            <HintPath>Core\0Harmony.dll</HintPath>
        </Reference>
        <Reference Include="PreludeLib">
            <HintPath>Core\PreludeLib.dll</HintPath>
        </Reference>
        <Reference Include="CSharpModBase">
            <HintPath>Core\CSharpModBase.dll</HintPath>
        </Reference>
        <Reference Include="CSharpModBase">
            <HintPath>Core\CSharpModBaseV2.dll</HintPath>
        </Reference>

    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
        <PackageReference Include="HttpMachine.PCL" Version="5.0.1" />
        <PackageReference Include="JetBrains.Annotations" Version="2025.2.2" />
        <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.8" />
        <PackageReference Include="Microsoft.Bcl.Numerics" Version="10.0.8" />
        <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.8" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.8" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.8" />
        <PackageReference Include="Mono.Cecil" Version="0.11.6" />
        <PackageReference Include="Superpower" Version="3.1.0" />
        <PackageReference Include="System.Collections.Immutable" Version="10.0.8" />
        <PackageReference Include="System.Memory" Version="4.6.3" />
        <PackageReference Include="System.Reflection.Emit" Version="4.7.0" />
        <PackageReference Include="System.Reflection.Metadata" Version="10.0.8" />
        <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
        <PackageReference Include="System.Text.Encodings.Web" Version="10.0.8" />
        <PackageReference Include="System.Text.Json" Version="10.0.8" />
        <PackageReference Include="Nito.AsyncEx.Context" Version="5.1.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\readym-gameserver\src\Friflo.Engine.ECS\src\ECS\Friflo.Engine.ECS.csproj" />
        <ProjectReference Include="..\readym-gameserver\src\ReadyM.Api.Multiplayer\ReadyM.Api.Multiplayer.csproj" />
        <ProjectReference Include="..\readym-gameserver\src\ReadyM.Api.Generators\ReadyM.Api.Generators.csproj" ReferenceOutputAssembly="true" OutputItemType="Analyzer" />
        <ProjectReference Include="..\readym-gameserver\src\ReadyM.Relay.Client\ReadyM.Relay.Client.csproj" />
        <ProjectReference Include="..\readym-gameserver\src\ReadyM.Wukong.Common\ReadyM.Wukong.Common.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Resources\BuiltinTexts.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>BuiltinTexts.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Resources\BuiltinTexts.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>BuiltinTexts.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Resources\BuiltinTexts.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>BuiltinTexts.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Resources\BuiltinTexts.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>BuiltinTexts.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>


    <ItemGroup>
        <!-- Reference-only assemblies for the game. Compile-time only, the real
             assemblies are already loaded in the game process at runtime. -->
        <PackageReference Include="ReadyM.Wukong.GameRefs" Version="1.0.21.23831-preview.1" />
    </ItemGroup>
</Project>