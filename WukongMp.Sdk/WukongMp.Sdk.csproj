<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <LangVersion>14</LangVersion>
        <OutputType>Library</OutputType>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <Nullable>enable</Nullable>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <RootNamespace>WukongMp.Sdk</RootNamespace>
        <TargetName>WukongMp.Sdk</TargetName>
        <Configurations>Debug;Release;NoDisconnect</Configurations>
        <Platforms>AnyCPU</Platforms>
        <TargetFramework>netstandard2.0</TargetFramework>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <!-- The core SDK. Defaults to the submodule here; an uberrepo overrides it
         so one checkout is shared across every consumer. -->
    <PropertyGroup>
        <CoreSdkRoot Condition="'$(CoreSdkRoot)' == ''">$(MSBuildThisFileDirectory)..\readym-core-sdk</CoreSdkRoot>
    </PropertyGroup>

<ItemGroup>
        <ProjectReference Include="$(CoreSdkRoot)\src\Friflo.Engine.ECS\src\ECS\Friflo.Engine.ECS.csproj" />
        <ProjectReference Include="$(CoreSdkRoot)\src\ReadyM.Api\ReadyM.Api.csproj" />
        <ProjectReference Include="..\WukongMp.Api\WukongMp.Api.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="CSharpModBase">
          <HintPath>..\WukongMp.Api\Core\CSharpModBase.dll</HintPath>
        </Reference>
        <Reference Include="CSharpModBaseV2">
          <HintPath>..\WukongMp.Api\Core\CSharpModBaseV2.dll</HintPath>
        </Reference>
        <Reference Include="PreludeLib">
          <HintPath>..\WukongMp.Api\Core\PreludeLib.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
      <None Update="manifest.json">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>


    <ItemGroup>
        <!-- Reference-only assemblies for the game. Compile-time only, the real
             assemblies are already loaded in the game process at runtime. -->
        <PackageReference Include="ReadyM.Wukong.GameRefs" Version="1.0.21.23831" />
    </ItemGroup>
</Project>
