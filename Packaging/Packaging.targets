<Project>

    <!--
        Shared packaging logic for the three SDK packages.

        Each package lists the assemblies it owns in @(SdkPackageAssembly). Nothing else is
        packed, even though the build has every transitive assembly on hand. That is the
        point: the lists are the boundary between the client and server surfaces, so an
        assembly can only reach a mod through the package that claims it, and a mistake
        shows up as a build error here rather than as a mod loading client code on a server.
    -->

    <PropertyGroup>
        <!-- the repository keeps projects unpackable; these three are the exceptions -->
        <IsPackable>true</IsPackable>
        <!-- these projects compile nothing of their own, so keep the empty assembly out -->
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <!-- NU5128: a lib folder with no matching dependency group, expected here -->
        <NoWarn>$(NoWarn);NU5128;CS2008</NoWarn>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackSdkAssemblies</TargetsForTfmSpecificContentInPackage>

        <Authors>ReadyCode Limited</Authors>
        <Company>ReadyCode Limited</Company>
        <PackageTags>wukong;wukongmp;readym;modding;multiplayer</PackageTags>
        <PackageProjectUrl>https://github.com/readycodeio/wukongmp-sdk</PackageProjectUrl>
        <RepositoryUrl>https://github.com/readycodeio/wukongmp-sdk</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

        <CoreSdkRoot Condition="'$(CoreSdkRoot)' == ''">$(MSBuildThisFileDirectory)..\readym-core-sdk</CoreSdkRoot>
    </PropertyGroup>

    <Target Name="PackSdkAssemblies" DependsOnTargets="ResolveReferences">

        <ItemGroup>
            <_Candidate Include="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.dll'" />
        </ItemGroup>

        <PropertyGroup>
            <_AllowList>;@(SdkPackageAssembly);</_AllowList>
            <_AnalyzerList>;@(SdkPackageAnalyzer);</_AnalyzerList>
        </PropertyGroup>

        <ItemGroup>
            <_Owned Include="@(_Candidate)" Condition="$(_AllowList.Contains(';%(Filename);'))" />
            <_OwnedAnalyzer Include="@(_Candidate)" Condition="$(_AnalyzerList.Contains(';%(Filename);'))" />

            <!-- DestinationSubDirectory carries the locale for satellite assemblies and is
                 empty for everything else, so one expression handles both. -->
            <TfmSpecificPackageFile Include="@(_Owned)"
                                    PackagePath="lib/$(TargetFramework)/%(_Owned.DestinationSubDirectory)" />

            <TfmSpecificPackageFile Include="@(_Owned->'%(RootDir)%(Directory)%(Filename).xml')"
                                    Condition="Exists('%(RootDir)%(Directory)%(Filename).xml')"
                                    PackagePath="lib/$(TargetFramework)/" />

            <!-- Analyzers are framework-neutral, so only the first target framework emits
                 them. Packing them per framework would collide on the same path. -->
            <TfmSpecificPackageFile Include="@(_OwnedAnalyzer)" PackagePath="analyzers/dotnet/cs/"
                                    Condition="'$(TargetFramework)' == '$(_PrimaryTargetFramework)'" />
        </ItemGroup>

        <!--
            An assembly that was listed but never resolved would silently drop out of the
            package and only surface as a missing reference in somebody's mod, so fail here.
        -->
        <ItemGroup>
            <_FoundName Include="@(_Owned->'%(Filename)')" />
            <_FoundName Include="@(_OwnedAnalyzer->'%(Filename)')" />
        </ItemGroup>
        <PropertyGroup>
            <_FoundList>;@(_FoundName);</_FoundList>
        </PropertyGroup>
        <ItemGroup>
            <_MissingName Include="@(SdkPackageAssembly);@(SdkPackageAnalyzer)"
                          Condition="!$(_FoundList.Contains(';%(Identity);'))" />
        </ItemGroup>
        <Error Condition="'@(_MissingName)' != ''"
               Text="$(PackageId) ($(TargetFramework)) lists assemblies that the build did not produce: @(_MissingName). Either a ProjectReference is missing or the name is wrong." />

    </Target>

</Project>
