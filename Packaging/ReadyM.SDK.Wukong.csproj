<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Packaging-only project. It compiles nothing of its own; it exists to collect the
        SDK assemblies into a single NuGet package.

        Both SDKs ship as one package on purpose. The core SDK is not released on its own
        and has no version of its own, so splitting it out would only create the chance of
        a mod resolving a core version that never shipped with this Wukong version.

        Two lib folders, because mods come in two shapes: netstandard2.0 for the in-game
        client and shared assemblies, net10.0 for server-side mods.
    -->

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
        <IsPackable>true</IsPackable>
        <!-- this project's own (empty) assembly must not land in the package -->
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <NoWarn>$(NoWarn);NU5128;CS2008</NoWarn>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackSdkAssemblies</TargetsForTfmSpecificContentInPackage>

        <PackageId>ReadyM.SDK.Wukong</PackageId>
        <Title>WukongMP SDK</Title>
        <Authors>ReadyCode Limited</Authors>
        <Company>ReadyCode Limited</Company>
        <Description>SDK for writing WukongMP mods. Contains the WukongMP game SDK and the ReadyM core SDK it builds on.</Description>
        <PackageTags>wukong;wukongmp;readym;modding;multiplayer</PackageTags>
        <PackageProjectUrl>https://github.com/readycodeio/wukong-csharp-mod</PackageProjectUrl>
        <RepositoryUrl>https://github.com/readycodeio/wukong-csharp-mod</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <PropertyGroup>
        <CoreSdkRoot Condition="'$(CoreSdkRoot)' == ''">$(MSBuildThisFileDirectory)..\readym-core-sdk</CoreSdkRoot>
    </PropertyGroup>

    <!--
        The client-side surface. Everything else the mods compile against arrives
        transitively, so this list stays short deliberately.
    -->
    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <ProjectReference Include="..\WukongMp.Sdk\WukongMp.Sdk.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\WukongMp.Api\WukongMp.Api.csproj" PrivateAssets="all" />
    </ItemGroup>

    <!-- The server-side surface. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <ProjectReference Include="..\WukongMp.Sdk.Serverside\WukongMp.Sdk.Serverside.csproj" PrivateAssets="all" />
    </ItemGroup>

    <!-- The source generator, packed as an analyzer rather than a reference. -->
    <ItemGroup>
        <ProjectReference Include="$(CoreSdkRoot)\src\ReadyM.Api.Generators\ReadyM.Api.Generators.csproj"
                          PrivateAssets="all" ReferenceOutputAssembly="true" />
    </ItemGroup>


    <!--
        Third-party dependencies of the bundled assemblies. They are declared rather than
        bundled, so a mod restores them from nuget.org as normal and we do not ship copies
        of other people's assemblies.

        Generated from the projects in each lib folder. Do not hand-edit: run
        BuildSdkPackage.ps1 -SyncDependencies to regenerate, or -CheckDependencies
        to fail when a bundled project has gained or changed a dependency.
    -->
    <!-- BEGIN GENERATED DEPENDENCIES -->
    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
        <PackageReference Include="DryIoc.dll" Version="5.4.3" />
        <PackageReference Include="Friflo.Json.Fliox" Version="1.0.4" />
        <PackageReference Include="Friflo.Json.Fliox.Annotation" Version="1.0.4" />
        <PackageReference Include="HttpMachine.PCL" Version="5.0.1" />
        <PackageReference Include="JetBrains.Annotations" Version="2025.2.2" />
        <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.8" />
        <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.8" />
        <PackageReference Include="Microsoft.Bcl.Numerics" Version="10.0.8" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.8" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.8" />
        <PackageReference Include="Mono.Cecil" Version="0.11.6" />
        <PackageReference Include="Nito.AsyncEx" Version="5.1.2" />
        <PackageReference Include="Nito.AsyncEx.Context" Version="5.1.2" />
        <PackageReference Include="ReadyM.Wukong.GameRefs" Version="1.0.21.23831-preview.1" />
        <PackageReference Include="Superpower" Version="3.1.0" />
        <PackageReference Include="System.Collections.Immutable" Version="10.0.8" />
        <PackageReference Include="System.Memory" Version="4.6.3" />
        <PackageReference Include="System.Numerics.Vectors" Version="4.6.1" />
        <PackageReference Include="System.Reflection.Emit" Version="4.7.0" />
        <PackageReference Include="System.Reflection.Metadata" Version="10.0.8" />
        <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
        <PackageReference Include="System.Text.Encodings.Web" Version="10.0.8" />
        <PackageReference Include="System.Text.Json" Version="10.0.8" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="DryIoc.dll" Version="5.4.3" />
        <PackageReference Include="Friflo.Json.Fliox" Version="1.0.4" />
        <PackageReference Include="Friflo.Json.Fliox.Annotation" Version="1.0.4" />
        <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.8" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
        <PackageReference Include="Superpower" Version="3.1.0" />
        <PackageReference Include="System.Collections.Immutable" Version="10.0.8" />
        <PackageReference Include="System.Numerics.Vectors" Version="4.6.1" />
        <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
        <PackageReference Include="System.Text.Encodings.Web" Version="10.0.8" />
        <PackageReference Include="System.Text.Json" Version="10.0.8" />
    </ItemGroup>
    <!-- END GENERATED DEPENDENCIES -->
    <!--
        Mod loader assemblies. Mods patch through Harmony and derive from the loader's
        base types, so they need these at compile time. Client side only.
    -->
    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <None Include="..\WukongMp.Api\Core\*.dll" Pack="true" PackagePath="lib/netstandard2.0/" />
    </ItemGroup>

    <Target Name="PackSdkAssemblies" DependsOnTargets="ResolveReferences">
        <ItemGroup>
            <!-- Only assemblies produced by our own projects. Third-party assemblies stay
                 out of the package and are declared as dependencies instead. -->
            <_SdkAssembly Include="@(ReferenceCopyLocalPaths)"
                          Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference' And '%(Extension)' == '.dll'" />

            <_Analyzer Include="@(_SdkAssembly)" Condition="'%(Filename)' == 'ReadyM.Api.Generators'" />
            <_Library Include="@(_SdkAssembly)" Exclude="@(_Analyzer)" />

            <TfmSpecificPackageFile Include="@(_Library)"
                                    PackagePath="lib/$(TargetFramework)/%(_Library.DestinationSubDirectory)" />
            <!-- analyzers are framework-neutral, so emit them for one target only -->
            <TfmSpecificPackageFile Include="@(_Analyzer)" PackagePath="analyzers/dotnet/cs/"
                                    Condition="'$(TargetFramework)' == 'netstandard2.0'" />

            <!-- XML documentation, so IntelliSense works against the package -->
            <TfmSpecificPackageFile Include="@(_Library->'%(RootDir)%(Directory)%(Filename).xml')"
                                    Condition="Exists('%(RootDir)%(Directory)%(Filename).xml')"
                                    PackagePath="lib/$(TargetFramework)/" />
        </ItemGroup>
    </Target>

</Project>
